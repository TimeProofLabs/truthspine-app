{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/claude-lifecycle-runner.mjs"
            ],
            "timeout": 45
          }
        ]
      }
    ]
  }
}
